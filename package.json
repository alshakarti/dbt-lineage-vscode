{
  "name": "dbt-lineage",
  "displayName": "dbt Lineage",
  "description": "Interactive dbt model lineage visualization — upstream/downstream DAG graph in the VS Code sidebar",
  "version": "0.1.0",
  "publisher": "dbt-lineage",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dbt",
    "lineage",
    "dag",
    "data",
    "analytics engineering"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "dbt-lineage",
          "title": "DBT LINEAGE",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dbt-lineage": [
        {
          "type": "webview",
          "id": "dbtLineage.view",
          "name": "Lineage",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "dbtLineage.focusCurrent",
        "title": "dbt Lineage: Focus on Current Model",
        "icon": "$(target)"
      },
      {
        "command": "dbtLineage.showFullProject",
        "title": "dbt Lineage: Show Full Project Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbtLineage.refresh",
        "title": "dbt Lineage: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {},
    "configuration": {
      "title": "dbt Lineage",
      "properties": {
        "dbtLineage.enableLiveParser": {
          "type": "boolean",
          "default": false,
          "description": "Parse ref()/source() calls from .sql files in real-time on every save, without needing to run dbt. When disabled, only target/manifest.json is used."
        },
        "dbtLineage.defaultDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Default number of hops to show upstream and downstream from the focused model."
        },
        "dbtLineage.manifestPath": {
          "type": "string",
          "default": "",
          "description": "Override path to manifest.json (relative to workspace root). Leave empty to auto-detect from target/manifest.json."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build:prod": "node esbuild.mjs --production",
    "package": "npm run build:prod && npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run build:prod",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
